# Copy this file to `.env.local` for local development.
# Every variable here is OPTIONAL. The site works without any of them.

# Your deployed site URL (used for SEO / Open Graph links).
# Example: https://your-name.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional GitHub token (server-side only, NOT exposed to the browser).
# Only needed if you hit GitHub's anonymous rate limit (60 requests/hour per IP).
# Create a token with NO scopes (public data only) at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional contact-form endpoint, e.g. a free Formspree form:
# https://formspree.io/f/xxxxxxxx
# If empty, the contact form is hidden and visitors are pointed to GitHub / email.
NEXT_PUBLIC_FORM_ENDPOINT=
